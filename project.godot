; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="jogo2d"
run/main_scene="uid://bvlxlqmykqgm0"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=288
window/size/viewport_height=208
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

Player=""

[layer_names]

2d_physics/layer_1="Inverno"
2d_physics/layer_2="Outono"
2d_physics/layer_3="Verao"
2d_physics/layer_4="Misc"
2d_physics/layer_5="player"
2d_physics/layer_6="enemies"
2d_physics/layer_7="fim"
2d_physics/layer_8="tropical"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
2d/snap/snap_2d_transforms_to_pixel=true
